PUBLIC_URL=https://tough-jay-refined.ngrok-free.app
NGROK_DOMAIN=tough-jay-refined.ngrok-free.app
OAUTH_ISSUER=https://your-authorization-server/
OAUTH_JWKS_URL=https://your-authorization-server/.well-known/jwks.json
# Shared API identifier configured at the OAuth provider; not inferred from project paths.
OAUTH_AUDIENCE=https://tough-jay-refined.ngrok-free.app/mcp
# Application login user ID: bare ID or full provider|ID (not dashboard account).
OWNER_SUBJECT=YOUR_USER_ID
# Enter locally; never commit a real token.
NGROK_AUTHTOKEN=

# Required only for compose.ec2.yaml; replace with your Docker Hub image.
APP_IMAGE=YOUR_DOCKERHUB_USERNAME/standard-mcp-backend:0.1.0

# Temporarily set to 1 to log verified/configured user IDs on owner mismatch.
AUTH_DEBUG_USER_IDS=0

# DEBUG gives detailed request/MCP/database/auth traces without payload contents.
LOG_LEVEL=INFO
